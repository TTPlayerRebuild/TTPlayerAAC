find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(TTP_FFMPEG_BUILD "${CMAKE_CURRENT_BINARY_DIR}/ffmpeg" CACHE PATH "Private ALAC backend cache")
set(TTP_FFMPEG_SOURCE "" CACHE PATH "Optional complete FFmpeg 9.0.2 source")
set(TTP_FFMPEG_BASH "" CACHE FILEPATH "Optional Git for Windows bash.exe")
set(TTP_FFMPEG_MAKE "" CACHE FILEPATH "Optional existing native GNU make")
if(NOT TTP_FFMPEG_SOURCE AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/ffmpeg/configure")
  set(TTP_FFMPEG_SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/third_party/ffmpeg")
endif()
set(_alac_args)
if(TTP_FFMPEG_SOURCE)
  list(APPEND _alac_args --source "${TTP_FFMPEG_SOURCE}")
  set(_alac_source "${TTP_FFMPEG_SOURCE}")
else()
  set(_alac_source "${TTP_FFMPEG_BUILD}/ffmpeg-9.0.2")
endif()
if(TTP_FFMPEG_BASH)
  list(APPEND _alac_args --bash "${TTP_FFMPEG_BASH}")
endif()
if(TTP_FFMPEG_MAKE)
  list(APPEND _alac_args --make "${TTP_FFMPEG_MAKE}")
endif()
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/third_party/make-4.4.1.tar.gz")
  list(APPEND _alac_args --make-archive "${CMAKE_CURRENT_SOURCE_DIR}/third_party/make-4.4.1.tar.gz")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/ffmpeg-source-path.txt" "${_alac_source}")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/cmake/build_alac.py"
  --build "${TTP_FFMPEG_BUILD}" --vs "${CMAKE_GENERATOR_INSTANCE}"
  --ltl "${ttplayer_vc_ltl_SOURCE_DIR}" ${_alac_args} COMMAND_ERROR_IS_FATAL ANY)
add_library(ttp_alac INTERFACE)
target_include_directories(ttp_alac INTERFACE "${_alac_source}" "${TTP_FFMPEG_BUILD}/ffmpeg-alac")
target_link_libraries(ttp_alac INTERFACE "${TTP_FFMPEG_BUILD}/ffmpeg-alac/libavcodec/avcodec.lib"
  "${TTP_FFMPEG_BUILD}/ffmpeg-alac/libavutil/avutil.lib" bcrypt)
